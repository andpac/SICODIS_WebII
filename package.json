{
  "name": "sicodis",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:SICODIS": "node dist/sicodis/server/server.mjs",
    "screenshots": "tsx scripts/screenshot-generator.ts",
    "screenshots:list": "tsx scripts/screenshot-generator.ts list",
    "screenshots:optimize": "tsx scripts/optimize-images.ts",
    "screenshots:all": "npm run screenshots && npm run screenshots:optimize",
    "screenshots:help": "echo 'Comandos disponibles:\\n  npm run screenshots          - Genera todos los screenshots\\n  npm run screenshots:list     - Lista screenshots disponibles\\n  npm run screenshots:optimize - Optimiza imágenes generadas\\n  npm run screenshots:all      - Genera y optimiza todo\\n\\nPara screenshots específicos:\\n  npm run screenshots <id1> <id2>\\n\\nEjemplo:\\n  npm run screenshots menu-principal sgp-resumen-completo'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.1.0",
    "@angular/cdk": "^17.0.0",
    "@angular/common": "^18.1.0",
    "@angular/compiler": "^18.1.0",
    "@angular/core": "^18.1.0",
    "@angular/forms": "^18.1.0",
    "@angular/material": "^17.0.0",
    "@angular/platform-browser": "^18.1.0",
    "@angular/platform-browser-dynamic": "^18.1.0",
    "@angular/platform-server": "^18.1.0",
    "@angular/router": "^18.1.0",
    "@angular/ssr": "^18.1.4",
    "@primeng/themes": "^18.0.0",
    "@types/leaflet": "^1.9.17",
    "chart.js": "^4.4.6",
    "chartjs-chart-treemap": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "express": "^4.18.2",
    "highcharts": "^12.2.0",
    "highcharts-angular": "^4.0.1",
    "leaflet": "^1.9.4",
    "ngx-cookie-service": "^18.0.0",
    "ngx-gauge": "^10.0.0",
    "ol": "^10.6.1",
    "primeicons": "^7.0.0",
    "primeng": "^18.0.0",
    "rxjs": "~7.8.0",
    "tailwindcss-primeui": "^0.3.4",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.1.4",
    "@angular/cli": "^18.1.4",
    "@angular/compiler-cli": "^18.1.0",
    "@playwright/test": "^1.40.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "autoprefixer": "^10.4.20",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.49",
    "sharp": "^0.33.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.7.0",
    "typescript": "~5.5.2"
  },
  "resolutions": {
    "rollup": "npm:@rollup/wasm-node@*"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5"
  }
